# Copy this file to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/adsoptima

# Set to "true" when your database requires SSL (most hosted providers do)
DATABASE_SSL=false

# Secret used to sign session tokens. Must be at least 32 characters in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# Public URL of the site, used for canonical and social-preview links
NEXT_PUBLIC_SITE_URL=http://localhost:7000
